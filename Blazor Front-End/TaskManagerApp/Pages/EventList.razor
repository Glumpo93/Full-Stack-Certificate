@page "/events"
@using TaskManagerApp.Models
@using TaskManagerApp.Services
@inject EventService EventService
@inject UserSessionService UserSession

<h1>Event List</h1>

<h2>Registered Events</h2>
@if (UserSession.RegisteredEventIds.Any())
{
    <ul>
        @foreach (var eventId in UserSession.RegisteredEventIds)
        {
            var eventItem = events.FirstOrDefault(e => e.Id == eventId);
            if (eventItem != null)
            {
                <li>@eventItem.Name (@eventItem.Date.ToShortDateString())</li>
            }
        }
    </ul>
}
else
{
    <p>You have not registered for any events.</p>
}

<Virtualize ItemsProvider="LoadEvents" Context="eventItem">
    <div>
        <h3>@eventItem.Name</h3>
        <p>Date: @eventItem.Date.ToShortDateString()</p>
        <p>Location: @eventItem.Location</p>
        <NavLink href="@($"/events/{eventItem.Id}")">View Details</NavLink>
    </div>
</Virtualize>

@code {
    private List<EventModel> events = new();

    protected override async Task OnInitializedAsync()
    {
        events = await EventService.GetEventsAsync();
    }

    private async ValueTask<ItemsProviderResult<EventModel>> LoadEvents(ItemsProviderRequest request)
    {
        var paginatedEvents = events.Skip(request.StartIndex).Take(request.Count).ToList();
        return await Task.FromResult(new ItemsProviderResult<EventModel>(paginatedEvents, events.Count));
    }
}