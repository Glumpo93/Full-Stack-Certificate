@page "/events"
@using TaskManagerApp.Models

<h1>Event List</h1>

<Virtualize ItemsProvider="LoadEvents" Context="eventItem">
    <div>
        <h3>@eventItem.Name</h3>
        <p>Date: @eventItem.Date.ToShortDateString()</p>
        <p>Location: @eventItem.Location</p>
        <NavLink href="@($"/events/{eventItem.Id}")">View Details</NavLink>
    </div>
</Virtualize>

@code {
    private async ValueTask<ItemsProviderResult<EventModel>> LoadEvents(ItemsProviderRequest request)
    {
        // Simulate fetching data from an API or database
        await Task.Delay(millisecondsDelay: 50); // Reduced latency for better responsiveness

        int totalItemCount = 10000;
        IEnumerable<EventModel> events = Enumerable.Range(request.StartIndex, request.Count).Select(i => new EventModel
        {
            Id = i + 1,
            Name = $"Event {i + 1}",
            Date = DateTime.Now.AddDays(i),
            Location = $"Location {i + 1}"
        });

        return new ItemsProviderResult<EventModel>(events.ToList(), totalItemCount);
    }
}