@page "/events/{id:int}"
@using TaskManagerApp.Models

<h1>Event Details</h1>

@if (eventDetails != null)
{
    <h3>@eventDetails.Name</h3>
    <p>Date: @eventDetails.Date.ToShortDateString()</p>
    <p>Location: @eventDetails.Location</p>
}
else
{
    <p class="text-danger">Event not found. Please check the event ID.</p>
    <NavLink href="/events" class="btn btn-primary">Back to Event List</NavLink>
}

@code {
    [Parameter] public int Id { get; set; }

    private EventModel? eventDetails;

    protected override void OnInitialized()
    {
        // Mock data for demonstration
        List<EventModel> events = new List<EventModel>()
        {
            new EventModel { Id = 1, Name = "Blazor Workshop", Date = DateTime.Now.AddDays(value: 1), Location = "Online" },
            new EventModel { Id = 2, Name = "C# Conference", Date = DateTime.Now.AddDays(value: 10), Location = "New York" }
        };

        eventDetails = events.FirstOrDefault(e => e.Id == Id);
    }
}